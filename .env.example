# ─────────────────────────────────────────────────────────────────────
# Environment variables for the InitOption Vite + Vercel stack.
# Fill into .env / .env.local. Prefix rules:
#   VITE_*        → injected into the Vite client bundle (NOT secret)
#   NEXT_PUBLIC_* → exposed to the browser in Vite (NOT secret)
#   all others    → server-side only (Vercel API routes) — treat as SECRET
# ─────────────────────────────────────────────────────────────────────

# ─── Application base URL ─────────────────────────────────────────────
# Used by OAuth redirect URIs, webhooks and cron jobs.
APP_BASE_URL="https://your-domain.com"

# ─── Neon (Database) ─────────────────────────────────────────────────
# PostgreSQL connection string from the Neon dashboard (free tier).
DATABASE_URL="postgresql://USER:PASSWORD@ep-....aws.neon.tech/DATABASE?sslmode=require"

# ─── Supabase service role (server-side, until DB layer lives on Neon) ─
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-supabase-publishable-key"

# ─── Firebase (Authentication) ─────────────────────────────────────────
# Create a Firebase project (https://console.firebase.google.com), enable the
# "Email/Password" and "Google" sign-in providers, then paste the web app config
# into .env. The *server-side* Firebase Admin env (FIREBASE_PROJECT_ID, etc.)
# is read via Application Default Credentials on Vercel (or set explicitly).
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Server-side Firebase Admin (API routes verify the ID token with firebase-admin).
# On Vercel, "Set up" → "Environment Variables" with the values below. For local
# dev you can also run `gcloud auth application-default login` (then only
# FIREBASE_PROJECT_ID below is needed).
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth client used for the Firebase Google-sign-in provider (optional;
# normally Firebase manages the Google provider itself).
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Cloudinary (File Storage — Phase 3) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ─── Pusher (Realtime — Phase 4) ─────────────────────────────────────
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="us2"

# ─── Live market data websocket (optional) ───────────────────────────
VITE_MARKET_DATA_WS_URL="wss://your-market-data-gateway.example.com/ticks"

# ─── Application ───────────────────────────────────────────────────────
APP_BASE_URL="https://your-domain.com"

# ─── Payments (Plisio crypto) ────────────────────────────────────────
PLISIO_API_KEY="your-plisio-api-key"
PLISIO_IPN_SECRET="your-plisio-ipn-secret"
PLISIO_CALLBACK_URL="https://your-domain.com/api/crypto/webhook"

# ─── Payments (Sasapay M-Pesa) ───────────────────────────────────────
SASAPAY_CLIENT_ID="your-sasapay-client-id"
SASAPAY_CLIENT_SECRET="your-sasapay-client-secret"
SASAPAY_MERCHANT_CODE="your-sasapay-merchant-code"
SASAPAY_CALLBACK_TOKEN="your-sasapay-callback-token"
SASAPAY_BASE_URL="https://api.sasapay.app"
SASAPAY_ENVIRONMENT="sandbox"   # sandbox | production
SASAPAY_CALLBACK_BASE_URL="https://your-domain.com"   # optional; defaults to APP_BASE_URL

# ─── Email (Resend — free 3k/mo) ─────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="noreply@your-domain.com"

# ─── Cron (Vercel Cron Jobs — free) ──────────────────────────────────
CRON_SECRET="strong-random-secret"   # Authorization: Bearer <CRON_SECRET>
