{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/mobile-money/process-withdrawals",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/crypto/poll-withdrawals",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(manifest.json|site.webmanifest|favicon.ico|apple-touch-icon.png)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/system/(.*)", "destination": "/api/system?resource=$1" },
    { "source": "/api/public-bonus", "destination": "/api/system?resource=public-bonus" },
    { "source": "/api/site.webmanifest", "destination": "/api/system?resource=site.webmanifest" },
    { "source": "/api/seo", "destination": "/api/system?resource=seo" },
    { "source": "/api/blog/categories", "destination": "/api/blog?route=categories" },
    { "source": "/api/blog/posts", "destination": "/api/blog?route=posts" },
    { "source": "/api/blog/posts/(.*)", "destination": "/api/blog?route=post&slug=$1" },
    { "source": "/rss.xml", "destination": "/api/system?resource=rss" },
    { "source": "/api/auth/signup", "destination": "/api/system?resource=auth-signup" },
    { "source": "/api/mobile-money/deposit-callback", "destination": "/api/mobile-money/callback?flow=deposit" },
    { "source": "/api/mobile-money/withdraw-callback", "destination": "/api/mobile-money/callback?flow=withdraw" },
    { "source": "/api/profile", "destination": "/api/system?route=profile" },
    { "source": "/api/profile/(.*)", "destination": "/api/system?route=profile" },
    { "source": "/api/user/profile", "destination": "/api/system?route=profile" },
    { "source": "/api/platform-settings", "destination": "/api/system?route=platform-settings" },
    { "source": "/api/platform-settings/(.*)", "destination": "/api/system?route=platform-settings" },
    { "source": "/api/db/(.*)", "destination": "/api/system?route=db&__dbpath=$1" },
    { "source": "/api/rpc/(.*)", "destination": "/api/system?route=rpc&fn=$1" },
    { "source": "/api/cloudinary/upload", "destination": "/api/system?route=cloudinary-upload" },
    { "source": "/api/cloudinary/delete", "destination": "/api/system?route=cloudinary-delete" },
    { "source": "/api/cloudinary/public-url", "destination": "/api/system?route=cloudinary-public-url" },
    { "source": "/api/cloudinary/exists", "destination": "/api/system?route=cloudinary-exists" },
    { "source": "/api/pusher/auth", "destination": "/api/system?route=pusher-auth" },
    { "source": "/api/crypto/deposit-callback", "destination": "/api/crypto/create-payment?__callback=1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/robots.txt", "destination": "/api/system?resource=robots" },
    { "source": "/sitemap.xml", "destination": "/api/system?resource=sitemap" },
    {
      "source": "/(.*\\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|json|webmanifest|txt|xml|map|woff|woff2|ttf|eot))",
      "destination": "/$1"
    },
    { "source": "/(.*)", "destination": "/api/render?__pathname=$1" }
  ]
}
